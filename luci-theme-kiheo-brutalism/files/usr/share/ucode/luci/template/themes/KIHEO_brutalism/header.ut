{%
	import { getuid, getspnam } from 'luci.core';

	const boardinfo = ubus.call("system", "board");
	const hostname = striptags(boardinfo?.hostname ?? 'KIHEO');

	http.prepare_content('text/html; charset=UTF-8');
-%}
<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
	<title>{{ hostname }}{{ node?.title ? ` - ${striptags(node.title)}` : '' }} - LuCI</title>
	<meta name="robots" content="noindex, nofollow">
	<link rel="icon" href="{{ media }}/logo.svg" type="image/svg+xml">
	<link rel="stylesheet" href="{{ media }}/cascade.css">
	{% if (node?.css): %}
	<link rel="stylesheet" href="{{ resource }}/{{ node.css }}">
	{% endif -%}
	{% if (css): %}
	<style title="text/css">{{ css }}</style>
	{% endif -%}
	<script>
		(function() {
			function createMemStorage() {
				var store = {};
				return {
					getItem: function(k) { return Object.prototype.hasOwnProperty.call(store, k) ? store[k] : null; },
					setItem: function(k, v) { store[k] = String(v); },
					removeItem: function(k) { delete store[k]; },
					clear: function() { store = {}; },
					key: function(i) { return Object.keys(store)[i] || null; },
					get length() { return Object.keys(store).length; }
				};
			}
			var needLocal = false;
			try {
				if (!window.localStorage) needLocal = true;
				else { window.localStorage.setItem('__test', '1'); window.localStorage.removeItem('__test'); }
			} catch (e) { needLocal = true; }
			if (needLocal) {
				var ls = createMemStorage();
				try { Object.defineProperty(window, 'localStorage', { value: ls, configurable: true, writable: true }); }
				catch (e1) { try { Object.defineProperty(Window.prototype, 'localStorage', { value: ls, configurable: true }); } catch (e2) {} }
			}

			var needSession = false;
			try {
				if (!window.sessionStorage) needSession = true;
				else { window.sessionStorage.setItem('__test', '1'); window.sessionStorage.removeItem('__test'); }
			} catch (e) { needSession = true; }
			if (needSession) {
				var ss = createMemStorage();
				try { Object.defineProperty(window, 'sessionStorage', { value: ss, configurable: true, writable: true }); }
				catch (e1) { try { Object.defineProperty(Window.prototype, 'sessionStorage', { value: ss, configurable: true }); } catch (e2) {} }
			}
		})();
	</script>
	<script src="{{ dispatcher.build_url('admin/translations', dispatcher.lang) }}?v={{ version.luciversion }}"></script>
	<script src="{{ resource }}/cbi.js?v={{ version.luciversion }}"></script>
	<script src="{{ resource }}/luci.js?v={{ version.luciversion }}"></script>
</head>
<body class="lang_{{ dispatcher.lang }} {% if (ctx.authsession): %}logged-in{% endif %}" data-page="{{ entityencode(join('-', ctx.request_path), true) }}">
	<script>
		(function(){
			var m = 'soft';
			try {
				if (window.localStorage) {
					m = window.localStorage.getItem('kiheo_theme_mode') || '';
				}
			} catch (e) {}
			if (!m) {
				var cm = document.cookie.match(/(?:^|;\s*)kiheo_theme_mode=([^;]+)/);
				m = cm ? decodeURIComponent(cm[1]) : 'soft';
			}
			if (m !== 'soft' && m !== 'dark' && m !== 'neon') m = 'soft';
			document.body.classList.add(m);
		})();
	</script>
	<div class="main">
		<!-- Argon Left Sidebar -->
		<aside class="main-left" id="mainmenu">
			<div class="sidenav-header">
				<a class="brand" href="{{ dispatcher.build_url('admin/status/overview') }}">KIHEO</a>
				<div class="sidenav-toggler" id="sidenavPinBtn" title="Toggle Menu">
					<div class="sidenav-toggler-line"></div>
					<div class="sidenav-toggler-line"></div>
					<div class="sidenav-toggler-line"></div>
				</div>
			</div>
			<ul id="argon-nav"></ul>
		</aside>

		<!-- Right Main Area -->
		<div class="main-right">
			<header class="bg-primary">
				<div class="fill">
					<div class="container">
						<div class="header-left-group">
							<div class="flex1">
								<a class="showSide" id="mobileSideToggle" title="Menu">
									<span></span>
									<span></span>
									<span></span>
								</a>
								<div class="quick-icons">
									<a href="/cgi-bin/luci/admin/network/network" title="Interface"><img src="{{ media }}/navbar/interface.svg" width="36" height="36" alt="Interface"></a>
									<a href="/cgi-bin/luci/admin/system/tinyfm" title="TinyFM"><img src="{{ media }}/navbar/tinyfm.svg" width="36" height="36" alt="TinyFM"></a>
									<a href="/cgi-bin/luci/admin/services/openclash" title="OpenClash"><img src="{{ media }}/navbar/openclash.svg" width="36" height="36" alt="OpenClash"></a>
									<a href="/cgi-bin/luci/admin/services/nikki" title="Nikki"><img src="{{ media }}/navbar/nikki.svg" width="36" height="36" alt="Nikki"></a>
									<a href="/cgi-bin/luci/admin/status/netmonitor" title="NetMon"><img src="{{ media }}/navbar/netmon.svg" width="36" height="36" alt="NetMon"></a>
								</div>
							</div>
							<nav id="menu">
								<ul>
									<li><a href="/cgi-bin/luci/admin/services/ttyd">Terminal</a></li>
									<li><a href="/cgi-bin/luci/admin/nas/samba4">Nas</a></li>
									<li><a href="/cgi-bin/luci/admin/modem/huawei_hilink">Modem</a></li>
									<li><a id="zash" href="http://192.168.1.1:9090/ui/zashboard/#" target="_blank">Zash</a></li>
								</ul>
							</nav>
						</div>

						<div class="status" id="indicators">
							<button type="button" class="header-theme-btn" id="headerThemeBtn" title="Ganti Gaya Tema">SOFT</button>
						</div>
					</div>
				</div>
			</header>

			<div class="darkMask" id="darkMask"></div>

			<div id="maincontent">
				<div class="container">
					{% if (getuid() == 0 && getspnam('root')?.pwdp === ''): %}
					<div class="alert-message error">
						<h4>{{ _('No password set!') }}</h4>
						<p>{{ _('There is no password set on this router. Please configure a root password to protect the web interface.') }}</p>
						{% if (dispatcher.lookup("admin/system/admin")): %}
						<div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/system/admin") }}">{{ _('Go to password configuration...') }}</a></div>
						{% endif %}
					</div>
					{% endif %}

					<noscript>
						<div class="alert-message error">
							<h4>{{ _('JavaScript required!') }}</h4>
							<p>{{ _('You must enable JavaScript in your browser or LuCI will not work properly.') }}</p>
						</div>
					</noscript>

					<div id="tabmenu" style="display:none"></div>
